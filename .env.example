# Copy to .env.local and fill in. Never commit a filled-in copy —
# note the filename pattern: .gitignore matches `.env*`, so anything
# named `env copy.txt`, `env-backup`, `prod env.txt` etc. is NOT ignored.

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key, safe to ship to the browser>
# Bypasses every RLS policy. Server-only. Treat as a database password.
SUPABASE_SERVICE_ROLE_KEY=<service_role key, never NEXT_PUBLIC_>

# Xendit — dashboard > settings > API keys
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Resend — resend.com/api-keys
RESEND_API_KEY=

NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_SITE_URL=
TEAM_EMAIL=
